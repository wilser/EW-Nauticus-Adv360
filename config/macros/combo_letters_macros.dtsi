#include <dt-bindings/zmk/keys.h>


// --------------------
// ALL FOR THE QU / Q CASES

// timings - see https://zmk.dev/docs/behaviors/macros#wait-time 
    // wait-time = how long between <bindings>
    // tap-time = how long each binding is 'held'
// when timing too slow, fast typing injects other keystrokes between the Q and the U // even with ~0 it's tricky

// trying to get into key layout:
// tap: qu, shift-tap: Qu, hold: q, shift-hold: Q

// ▢ maybe the "keep-mods = ..." could help?

    // 2025-03-27 NOT USED NOW
    /*
    as_Qu: auto_shift_Qu {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <150>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&mm_qu_Qu>; // Hold > q, else qu|Qu
    };
    */

// Q macros: --------------------
m_lcase_qu: m_lcase_qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp Q>, <&kp U>;
};

m_ucase_QU: m_ucase_QU {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp LS(Q)>, <&kp LS(U)>;
};

m_mixcase_Qu: m_mixcase_Qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <10>; // ??
    tap-ms = <5>; // ??
    #binding-cells = <0>;
    bindings =
              <&kp LS(Q)>
            , <&macro_release &kp LSHIFT>
            , <&macro_pause_for_release>
            , <&kp U>
    ;
};

// CAP layer HT --------------------
ht_QU_Q: ht_QU_Q {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which?
    tapping-term-ms = <200>; // ▢ TODO
    quick-tap-ms = <200>; // ▢ TODO
    bindings = <&kp>, <&m_ucase_QU>; // hold for Q, tap for QU macro
};



/* OPTION 1 --------------------
 * HoldTap ⇒
 *      > Q
 *      > ModMorph
 *          > qu
 *          > Qu
 */
 // NOT working - Shift+<> ⇒ Q


// MOD MORPH for qu Qu - note not &kp based!
mm_qu_Qu: mm_qu_Qu {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&m_lcase_qu>, <&m_mixcase_Qu>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
    keep-mods = <(MOD_LSFT|MOD_RSFT)>; // swallow the shift so Ø passed thru? (matter?)
  };

// HOLD TAP: Q | ModMorph(qu Qu)
ht_qu_QU: ht_qu_QU {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which? 
    tapping-term-ms = <200>; // ▢ TODO
    quick-tap-ms = <200>; // ▢ TODO
    bindings = <&kp>, <&mm_qu_Qu>; // hold <&kp>, tap <macro "qu">
};


