// ----------------------------------------------------------------------------------------------------

// for Nth cases: st, nd, rd, th - to put on NUM shift/holds
m_1st: m_1st {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>; // was 10
    tap-ms = <1>; // was 5
    #binding-cells = <0>;
    bindings = <&kp S>, <&kp T>;
};

m_2nd: m_2nd {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>; // was 10
    tap-ms = <1>; // was 5
    #binding-cells = <0>;
    bindings = <&kp N>, <&kp D>;
};

m_3rd: m_3rd {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>; // was 10
    tap-ms = <1>; // was 5
    #binding-cells = <0>;
    bindings = <&kp R>, <&kp D>;
};

m_4th: m_4th {
