    #binding-cells = <0>;
    bindings = <&kp T>, <&kp H>;
};

// _a.m.
m_am_lc: m_am_lc {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>; // was 10
    tap-ms = <1>; // was 5
    #binding-cells = <0>;
    bindings = <&kp A>, <&kp DOT>, <&kp M>, <&kp DOT>;
};

// _p.m.
m_pm_lc: m_pm_lc {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>; // was 10
    tap-ms = <1>; // was 5
    #binding-cells = <0>;
    bindings = <&kp P>, <&kp DOT>, <&kp M>, <&kp DOT>;
};


// mod-morph shifts for these:
// ▢ TODO: see also the Q case. And make C-macros for...


// tap: the &kp, hold: the &macro for the letters...
// uses "&as_XX 0 #" in map; 0 parm for the nil macro parm; note macro is FIRST
#define TAPPING_TERM_NUMPAD_HOLDS 225

as_1st: auto_shift_1st {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <TAPPING_TERM_NUMPAD_HOLDS>;
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
    bindings = <&m_1st>, <&kp>; 
};
as_2nd: auto_shift_2nd {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <TAPPING_TERM_NUMPAD_HOLDS>;
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
    bindings = <&m_2nd>, <&kp>; 
};
as_3rd: auto_shift_3rd {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <TAPPING_TERM_NUMPAD_HOLDS>;
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
    bindings = <&m_3rd>, <&kp>; 
};
as_4th: auto_shift_4th {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <TAPPING_TERM_NUMPAD_HOLDS>;
    quick-tap-ms = <0>;
    flavor = "tap-preferred";
    bindings = <&m_4th>, <&kp>; 
};

// holds on NUM for very common post-NUM {a.m., p.m., AM, PM}
