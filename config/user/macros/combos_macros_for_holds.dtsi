#include <dt-bindings/zmk/keys.h>

/*****************************************************************************************************
 *  COMBO and MACRO configurations
 *  General TODOs/ Opens:
 *  - [ ] (type/key-send) macro-ify some of these? (e.g. the Q/QU/Qu cases)
 *  - [ ] see if can use mod-morph for some of the hold-tap combos (e.g. qu/QU) instead of hold-tap;
 *      or even macro-morph? (since not really mods)
 *  - [ ] make C-macros to make this tidier
 *  - [ ] general timings; many never really dialed in (wait- tap- tapping-term- quick-tap-ms); )
 */


// --------------------
// Q / QU cases
// tap: qu, shift-tap: Qu, hold: q (Engram layer) / shift-hold: Q (CAP layer)

// Q macros: --------------------
m_lcase_qu: m_lcase_qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp Q>, <&kp U>;
};

m_ucase_QU: m_ucase_QU {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp LS(Q)>, <&kp LS(U)>;
};

m_mixcase_Qu: m_mixcase_Qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <10>; 
    tap-ms = <5>;
    #binding-cells = <0>;
    bindings =
              <&kp LS(Q)>
            , <&macro_release &kp LSHIFT>
            , <&macro_pause_for_release>
            , <&kp U>
    ;
};

// CAP layer HT --------------------
ht_QU_Q: ht_QU_Q {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which?
    tapping-term-ms = <200>; 
    quick-tap-ms = <200>;
    bindings = <&kp>, <&m_ucase_QU>; // hold for Q, tap for QU macro
};


// MOD MORPH for qu Qu - note not &kp based!
mm_qu_Qu: mm_qu_Qu {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&m_lcase_qu>, <&m_mixcase_Qu>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
    keep-mods = <(MOD_LSFT|MOD_RSFT)>; // swallow the shift so Ø passed thru? (not sure matters)
  };

// HOLD TAP: Q | ModMorph(qu Qu)
ht_qu_QU: ht_qu_QU {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which? 
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    bindings = <&kp>, <&mm_qu_Qu>; // hold <&kp>, tap <macro "qu">
};



// ----------------------------------------------------------------------------------------------------
// NUM layer holds: ordinal suffixes and time abbreviations
// This file lives in macros {} — only zmk,behavior-macro nodes here.
// Corresponding hold-tap wrappers (ht_NAME) are in holdtaps_for_layers.dtsi via HT_FROM_MACRO.

// Local C macro: generates only the zmk behavior-macro node (variadic key sequence).
// NOTE: defined here (not def_macros.dtsi) because this file is included before behaviors {}.
#define MACRO_KPS(NAME, ...) \
m_##NAME: m_##NAME { \
    compatible = "zmk,behavior-macro"; \
    wait-ms = <0>; \
    tap-ms = <1>; \
    #binding-cells = <0>; \
    bindings = __VA_ARGS__; \
};

#define TAPPING_TERM_HT_MACRO 225

// X-macro: emit macro nodes for all hold=macro/tap=kp pairs (data in macro_ht_data.dtsi)
#define HT_MACRO_ENTRY MACRO_KPS
#include "macro_ht_data.dtsi"
#undef HT_MACRO_ENTRY


