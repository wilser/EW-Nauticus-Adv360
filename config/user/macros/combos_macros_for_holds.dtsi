#include <dt-bindings/zmk/keys.h>

/*****************************************************************************************************
 *  COMBO and MACRO configurations
 *  General TODOs/ Opens:
 *  - [ ] (type/key-send) macro-ify some of these? (e.g. the Q/QU/Qu cases)
 *  - [ ] see if can use mod-morph for some of the hold-tap combos (e.g. qu/QU) instead of hold-tap;
 *      or even macro-morph? (since not really mods)
 *  - [ ] make C-macros to make this tidier
 *  - [ ] general timings; many never really dialed in (wait- tap- tapping-term- quick-tap-ms); )
 */


// --------------------
// Q / QU cases
// tap: qu, shift-tap: Qu, hold: q (Engram layer) / shift-hold: Q (CAP layer)

// Q macros: --------------------
m_lcase_qu: m_lcase_qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp Q>, <&kp U>;
};

m_ucase_QU: m_ucase_QU {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp LS(Q)>, <&kp LS(U)>;
};

m_mixcase_Qu: m_mixcase_Qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    // mm_qu_Qu has no keep-mods, so shift is suppressed by the mod-morph during this macro.
    // LS(Q) adds shift explicitly for Q; U is sent without shift.
    bindings = <&kp LS(Q)>, <&kp U>;
};

// CAP layer HT --------------------
ht_QU_Q: ht_QU_Q {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which?
    tapping-term-ms = <200>; 
    quick-tap-ms = <200>;
    bindings = <&kp>, <&m_ucase_QU>; // hold for Q, tap for QU macro
};


// MOD MORPH for qu Qu - note not &kp based!
mm_qu_Qu: mm_qu_Qu {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&m_lcase_qu>, <&m_mixcase_Qu>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
    // no keep-mods: mod-morph suppresses shift while m_mixcase_Qu runs, so U is unshifted
  };

// HOLD TAP: Q | ModMorph(qu Qu)
ht_qu_QU: ht_qu_QU {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "tap-preferred"; // tap-preferred: hold only fires after tapping-term-ms, shift+tap stays tap
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    bindings = <&kp>, <&mm_qu_Qu>; // hold <&kp>, tap <macro "qu">
};



// ----------------------------------------------------------------------------------------------------
// Hold=macro / tap=kp pairs: ordinal suffixes, time abbreviations, etc.
// Generates both the zmk,behavior-macro node (m_NAME) and the hold-tap wrapper (ht_NAME).
// ZMK finds behaviors by compatible string regardless of DTS block — both nodes live here in macros{}.
// To add/change an entry: edit macro_ht_data.dtsi only.

#define TAPPING_TERM_HT_MACRO 225

// Combined C macro: emits m_NAME (macro) + ht_NAME (hold-tap) in one shot.
#define HT_MACRO_ENTRY(NAME, ...) \
m_##NAME: m_##NAME { \
    compatible = "zmk,behavior-macro"; \
    wait-ms = <0>; \
    tap-ms = <1>; \
    #binding-cells = <0>; \
    bindings = __VA_ARGS__; \
}; \
ht_##NAME: ht_##NAME { \
    compatible = "zmk,behavior-hold-tap"; \
    #binding-cells = <2>; \
    tapping-term-ms = <TAPPING_TERM_HT_MACRO>; \
    quick-tap-ms = <0>; \
    flavor = "tap-preferred"; \
    bindings = <&m_##NAME>, <&kp>; \
};

#include "macro_ht_data.dtsi"
#undef HT_MACRO_ENTRY


