#include <dt-bindings/zmk/keys.h>

/*****************************************************************************************************
 *  COMBO and MACRO configurations
 *  General TODOs/ Opens:
 *  - [ ] (type/key-send) macro-ify some of these? (e.g. the Q/QU/Qu cases)
 *  - [ ] see if can use mod-morph for some of the hold-tap combos (e.g. qu/QU) instead of hold-tap;
 *      or even macro-morph? (since not really mods)
 *  - [ ] make C-macros to make this tidier
 *  - [ ] general timings; many never really dialed in (wait- tap- tapping-term- quick-tap-ms); )
 */


// --------------------
// Q / QU cases
// tap: qu, shift-tap: Qu, hold: q (Engram layer) / shift-hold: Q (CAP layer)

// Q macros: --------------------
m_lcase_qu: m_lcase_qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp Q>, <&kp U>;
};

m_ucase_QU: m_ucase_QU {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp LS(Q)>, <&kp LS(U)>;
};

m_mixcase_Qu: m_mixcase_Qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <10>; 
    tap-ms = <5>;
    #binding-cells = <0>;
    bindings =
              <&kp LS(Q)>
            , <&macro_release &kp LSHIFT>
            , <&macro_pause_for_release>
            , <&kp U>
    ;
};

// CAP layer HT --------------------
ht_QU_Q: ht_QU_Q {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which?
    tapping-term-ms = <200>; 
    quick-tap-ms = <200>;
    bindings = <&kp>, <&m_ucase_QU>; // hold for Q, tap for QU macro
};


// MOD MORPH for qu Qu - note not &kp based!
mm_qu_Qu: mm_qu_Qu {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&m_lcase_qu>, <&m_mixcase_Qu>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
    keep-mods = <(MOD_LSFT|MOD_RSFT)>; // swallow the shift so Ø passed thru? (not sure matters)
  };

// HOLD TAP: Q | ModMorph(qu Qu)
ht_qu_QU: ht_qu_QU {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which? 
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    bindings = <&kp>, <&mm_qu_Qu>; // hold <&kp>, tap <macro "qu">
};



// ----------------------------------------------------------------------------------------------------
// NUM layer holds: ordinal suffixes and time abbreviations
// MACRO_HT (def_macros.dtsi) generates paired: m_NAME (zmk macro) + ht_NAME (hold-tap)
// In layer: &ht_NAME 0 <key>   (first param unused; second is the tap key)

#define TAPPING_TERM_NUMPAD_HOLDS 225

MACRO_HT(1st,        <&kp S>, <&kp T>)
MACRO_HT(2nd,        <&kp N>, <&kp D>)
MACRO_HT(3rd,        <&kp R>, <&kp D>)
MACRO_HT(4th,        <&kp T>, <&kp H>)
MACRO_HT(am_lc,      <&kp A>, <&kp DOT>, <&kp M>, <&kp DOT>)  // a.m.
MACRO_HT(pm_lc,      <&kp P>, <&kp DOT>, <&kp M>, <&kp DOT>)  // p.m.
MACRO_HT(hr_abbrev,  <&kp H>, <&kp R>)                         // hr
MACRO_HT(min_abbrev, <&kp M>, <&kp I>, <&kp N>)                // min


