// for Nth cases: st, nd, rd, th - to put on NUM shift/holds
m_1st: m_1st {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>; // was 10
    tap-ms = <1>; // was 5
    #binding-cells = <0>;
    bindings = <&kp S>, <&kp T>;
};

