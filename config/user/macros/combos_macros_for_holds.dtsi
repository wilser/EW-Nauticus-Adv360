#include <dt-bindings/zmk/keys.h>


// --------------------
// Q / QU cases
// tap: qu, shift-tap: Qu, hold: q (Engram layer) / shift-hold: Q (CAP layer)

// Q macros: --------------------
m_lcase_qu: m_lcase_qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp Q>, <&kp U>;
};

m_ucase_QU: m_ucase_QU {
    compatible = "zmk,behavior-macro";
    wait-ms = <0>;
    tap-ms = <1>;
    #binding-cells = <0>;
    bindings = <&kp LS(Q)>, <&kp LS(U)>;
};

m_mixcase_Qu: m_mixcase_Qu {
    compatible = "zmk,behavior-macro";
    wait-ms = <10>; // ??
    tap-ms = <5>; // ??
    #binding-cells = <0>;
    bindings =
              <&kp LS(Q)>
            , <&macro_release &kp LSHIFT>
            , <&macro_pause_for_release>
            , <&kp U>
    ;
};

// CAP layer HT --------------------
ht_QU_Q: ht_QU_Q {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which?
    tapping-term-ms = <200>; // ▢ TODO
    quick-tap-ms = <200>; // ▢ TODO
    bindings = <&kp>, <&m_ucase_QU>; // hold for Q, tap for QU macro
};



// MOD MORPH for qu Qu - note not &kp based!
mm_qu_Qu: mm_qu_Qu {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&m_lcase_qu>, <&m_mixcase_Qu>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
    keep-mods = <(MOD_LSFT|MOD_RSFT)>; // swallow the shift so Ø passed thru? (matter?)
  };

// HOLD TAP: Q | ModMorph(qu Qu)
ht_qu_QU: ht_qu_QU {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred"; // which? 
    tapping-term-ms = <200>; // ▢ TODO
    quick-tap-ms = <200>; // ▢ TODO
    bindings = <&kp>, <&mm_qu_Qu>; // hold <&kp>, tap <macro "qu">
};







