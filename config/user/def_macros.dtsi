// === DEF-MACROS (C preprocessor function-like macros) ===
// These are NOT ZMK macros (behavior type) — these are C preprocessor #define macros.
// Include this file FIRST in behaviors {} before any files that use these macros.
//
// Macros defined here:
//   MOD_MORPH(NAME, B1, B2, MODS)                    — standalone mod-morph (kp/kp)
//   MOD_MORPH_SHIFT(SUFFIX, KEY, MOD_KEY)            — mod-morph + hold-tap wrapper pair
//   HT_KP(NAME, TTM, QTM, FLAVOR)                    — hold-tap kp/kp, no positions
//   HT_KP_POS(NAME, TTM, QTM, FLAVOR, KEYS)          — hold-tap kp/kp + hold-trigger positions
//   HT_BINDS(NAME, TTM, QTM, FLAVOR, B1, B2)         — hold-tap custom bindings, no positions
//
// FLAVOR: pass pre-quoted string, e.g. "balanced" or "tap-preferred"
// KEYS:   pass position arrays unquoted, e.g. KEYS_RIGHT THUMBS MODS_LEFT

// ─────────────────────────────────────────────────────────────────────────────
// MOD_MORPH(NAME, B1, B2, MODS)
//   Standalone mod-morph: tap=B1, morph=B2 when MODS held
//   MODS: single (MOD_LSFT) or combined (MOD_LSFT|MOD_RSFT)
//   Usage: MOD_MORPH(mm_bslh_bspc, BSLH, BACKSPACE, MOD_LSFT)
#define MOD_MORPH(NAME, B1, B2, MODS) \
NAME: NAME { \
    compatible = "zmk,behavior-mod-morph"; \
    #binding-cells = <0>; \
    bindings = <&kp B1>, <&kp B2>; \
    mods = <(MODS)>; \
};

// ─────────────────────────────────────────────────────────────────────────────
// MOD_MORPH_SHIFT(SUFFIX, KEY, MOD_KEY)
//   Generates a pair of behaviors:
//     mm_##SUFFIX  — mod-morph: tap=KEY, shifted=MOD_KEY
//     mms_##SUFFIX — hold-tap wrapper around mm_##SUFFIX (auto-shift style)
//   Usage in layers: &mms_##SUFFIX <hold-key> 0
#define MOD_MORPH_SHIFT(SUFFIX, KEY, MOD_KEY) \
mm_##SUFFIX: mm_##SUFFIX { \
    compatible = "zmk,behavior-mod-morph"; \
    #binding-cells = <0>; \
    bindings = <&kp KEY>, <&kp MOD_KEY>; \
    mods = <(MOD_LSFT|MOD_RSFT)>; \
}; \
mms_##SUFFIX: mms_##SUFFIX { \
    compatible = "zmk,behavior-hold-tap"; \
    #binding-cells = <2>; \
    tapping-term-ms = <150>; \
    quick-tap-ms = <0>; \
    flavor = "tap-preferred"; \
    bindings = <&kp>, <&mm_##SUFFIX>; \
};

// ─────────────────────────────────────────────────────────────────────────────
// HOLD_TAP macros — three variants for zmk,behavior-hold-tap nodes

// Base: custom bindings, no hold-trigger positions
#define HT_BINDS(NAME, TTM, QTM, FLAVOR, B1, B2) \
NAME: NAME { \
    compatible = "zmk,behavior-hold-tap"; \
    #binding-cells = <2>; \
    tapping-term-ms = <TTM>; \
    quick-tap-ms = <QTM>; \
    flavor = FLAVOR; \
    bindings = <&B1>, <&B2>; \
};

// Shorthand: kp/kp bindings (most common) — delegates to HT_BINDS
#define HT_KP(NAME, TTM, QTM, FLAVOR) HT_BINDS(NAME, TTM, QTM, FLAVOR, kp, kp)

// kp/kp with hold-trigger positions (for one-handed homerow mods)
#define HT_KP_POS(NAME, TTM, QTM, FLAVOR, KEYS) \
NAME: NAME { \
    compatible = "zmk,behavior-hold-tap"; \
    #binding-cells = <2>; \
    tapping-term-ms = <TTM>; \
    quick-tap-ms = <QTM>; \
    flavor = FLAVOR; \
    bindings = <&kp>, <&kp>; \
    hold-trigger-key-positions = <KEYS>; \
};

// kp/kp urob-style "timeless" HRM: positional + require-prior-idle + hold-trigger-on-release
// PIDLE: require-prior-idle-ms (typ. 150) — suppresses hold if typed quickly after another key
// hold-trigger-on-release delays the hold/tap decision until key release (reduces false holds)
#define HT_HRM(NAME, TTM, QTM, PIDLE, FLAVOR, KEYS) \
NAME: NAME { \
    compatible = "zmk,behavior-hold-tap"; \
    #binding-cells = <2>; \
    tapping-term-ms = <TTM>; \
    quick-tap-ms = <QTM>; \
    require-prior-idle-ms = <PIDLE>; \
    flavor = FLAVOR; \
    hold-trigger-on-release; \
    bindings = <&kp>, <&kp>; \
    hold-trigger-key-positions = <KEYS>; \
};
