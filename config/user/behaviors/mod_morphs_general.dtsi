// MOD_MORPH(mm_SHIFT_BACKSPACE_R,   RSHFT, BACKSPACE, MOD_LSFT)
// MOD_MORPH(mm_SHIFT_BACKSPACE_L,   LSHFT, BACKSPACE, MOD_RSFT)
