// Custom hold-tap behaviors for adv360 keymap
// Uses HT_KP, HT_KP_POS, HT_BINDS from def_macros.dtsi
// (KEYS_LEFT, KEYS_RIGHT, THUMBS, MODS_* must be #defined before this file is included)

/*  MACRO SIGNATURES (from def_macros.dtsi)
    HT_KP    (NAME, TTM, QTM, FLAVOR)              — kp/kp, no positional trigger
    HT_KP_POS(NAME, TTM, QTM, FLAVOR, KEYS)        — kp/kp, hold only triggered by keys in KEYS
    HT_BINDS (NAME, TTM, QTM, FLAVOR, B1, B2)      — custom hold/tap bindings (e.g. mo/kp)
    HT_HRM   (NAME, TTM, QTM, PIDLE, FLAVOR, KEYS) — like HT_KP_POS + require-prior-idle-ms

    Parameters:
      TTM   = tapping-term-ms    hold longer than this → hold; shorter → tap
      QTM   = quick-tap-ms       if same key re-tapped within this ms, always tap (enables repeat);
                                   set 0 to disable, or =TTM to make 2x-tap-hold repeat
      PIDLE = require-prior-idle-ms  if any key pressed within this ms before this key → suppress hold
                                   (urob-style; breaks Ctrl+Shift chording — see NOTES below)
      FLAVOR = decision logic style (see below)
      KEYS  = hold-trigger-key-positions  only keys at these positions can trigger the hold;
                                   keys on the same hand → treated as tap (prevents finger-roll misfires)
      B1/B2 = hold / tap bindings (behavior refs without &, e.g. mo, kp, to)
*/

/*  NOTES - hold-tap
    FLAVORS: https://zmk.dev/docs/behaviors/hold-tap
        balanced:              best for most cases; if held long enough → hold, if fast+within time → hold, else tap
        tap-preferred:         assume tap unless stricter timing met; more 'deliberate'
        hold-preferred:        more forgiving hold (& more false-holds)
        tap-unless-interrupted: assumes tap even if slower, unless another key pressed
    TIMINGS: see below — e.g. slower for Win/GUI since false-holds wreck havoc

    // [.] 2024-12-21: still don't get the tap-term vs quick-tap nuances
    // [ ] 2026-03-07: some of the timings still unsure or need deeper dive / explanations

    // HT_HRM (def_macros.dtsi): urob-style — adds require-prior-idle-ms (suppresses hold if key
    //   pressed quickly after prior keypress) and optionally hold-trigger-on-release. Tested 2026-03:
    //   both params degraded Shift/Ctrl+Shift chording (idle window suppressed intentional mod holds).
    //   Revisit only if switching to a pure-roll typing style with no deliberate mod chording.
*/

/* positional HRM — hold-trigger-key-positions only (urob idle/release params not compatible with mod chording) */
/* 2026-03-09 testing timing to dial in the false-non-shift cases better: 200 > 250 (seems worse?) » try 150 to test extreme different; so far better*/
/* hm_l|hm_r only used for SHIFT */
HT_KP_POS(hm_l, 150, 125, "balanced", KEYS_RIGHT THUMBS MODS_LEFT KEYS_TAB) // make TAB exception so works fast also with same-hand mods
HT_KP_POS(hm_r, 150, 125, "balanced", KEYS_LEFT  THUMBS MODS_RIGHT)

/* slower for Win/GUI — false-holds are worse than false-taps */
HT_KP(hm_slw, 320, 200, "tap-preferred")

/* medium for other mod keys: Ctrl, Alt — positional to prevent same-hand roll misfires */
/* TTM _shorter_ means less window for the hold to take effect. So false holds > shorter TTM. Not enough > longer TTM.
    Can also do RH , LH separately if needed 
    2026-03-13: 230, getting _some_ false-holds
    2026-03-13: 200, 
    */
HT_KP_POS(hm_med_l, 200, 150, "balanced", KEYS_RIGHT THUMBS MODS_LEFT KEYS_TAB)
HT_KP_POS(hm_med_r, 200, 150, "balanced", KEYS_LEFT  THUMBS MODS_RIGHT)

/* auto-shift variants (binding-1=held, binding-2=tapped) */
HT_KP(as,      150,   0, "tap-preferred")
HT_KP(as_slw,  230,   0, "tap-preferred")

/* tap/hold/tap-hold-repeat — QTM=TTM so 2nd tap forces tap, enabling OS repeat on hold */
HT_KP(as_thr_med, 230, 230, "tap-preferred")  // medium speed (230ms)
HT_KP(as_thr_fst, 150, 150, "tap-preferred")  // fast (150ms)

/* layer-tap variants */
HT_BINDS(lt_fst, 150, 0, "tap-preferred", mo, kp)  // faster; after many attempts to dial in
HT_BINDS(lht,    170, 0, "tap-preferred", mo, to)   // hold=layer, tap=to(layer)
HT_BINDS(lt_slw, 230, 0, "tap-preferred", mo, kp)

/* hold=macro/tap=kp pairs (ht_NAME): generated in macros{} alongside m_NAME — see combos_macros_for_holds.dtsi */
